{
  "expo": {
    "name": "TuonTa!",
    "slug": "tuonta",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/branding/tuonta-icon.png",
    "scheme": "tuonta",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.gabri.tuonta",
      "supportsTablet": true,
      "icon": "./assets/branding/tuonta-icon.png"
    },
    "android": {
      "package": "com.gabri.tuonta",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/branding/tuonta-icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/branding/tuonta-icon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/branding/tuonta-logo.png",
          "imageWidth": 220
        }
      ],
      "expo-notifications"
    ]
  }
}
